# Gradle
.gradle/
build/
app/build/
local.properties
.kotlin/

# IDE
.idea/
*.iml
.DS_Store

# 本地模拟器（AVD 动辄几百 MB）
.emu/

# 签名材料不入库；例外：keystore/quandian-release.jks 入库作为统一正式签名，
# 保证本地与 CI 每个 release 用同一证书（否则回退 debug 证书会导致“签名不一致”无法覆盖升级）
keystore/*
!keystore/quandian-release.jks
*.jks
*.keystore
!keystore/quandian-release.jks
keystore.properties

# 构建产物
dist/
*.apk
*.aab
captures/

# 日志
*.log
